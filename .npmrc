# Mojang's @minecraft/server-admin and server-net declare peer deps on
# @minecraft/server ^1.x.x || ^2.x.x, but we (correctly) install the
# beta channel like 2.8.0-beta.1.26.21-stable, which semver ^2.0.0
# does not match because of the prerelease tag. Tell npm to treat
# peer-dep ranges as warnings instead of errors.
legacy-peer-deps=true
